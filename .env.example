# COSEC device API
# Local dev (Mode A): point this directly at the COSEC server on your LAN.
# Production (Mode B): the Vercel-hosted app cannot reach a private LAN IP directly —
# see /agent/cosec-agent (Phase 3) for how attendance gets from COSEC into the cloud DB.
COSEC_BASE_URL=http://192.168.0.107:85
COSEC_USERNAME=HR
COSEC_PASSWORD=

# PostgreSQL connection string (docker-compose.yml provides one for local dev)
DATABASE_URL=postgresql://cosec:cosec@localhost:5432/cosec_attendance

# NextAuth (Auth.js v5) — generate with: openssl rand -base64 32
AUTH_SECRET=
# Leave AUTH_URL unset for local dev (trustHost infers it per-request, so it
# doesn't matter which port `next dev` picks). Set it to the real canonical
# URL in production, e.g. https://your-domain.vercel.app
# AUTH_URL=

# Seeded dashboard admin user, used by `npx prisma db seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Server-only key used to encrypt COSEC settings overrides saved from the Settings UI.
# 32 bytes, hex-encoded — generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Frappe HRMS (Phase 2) — see README "Connecting Frappe HRMS" for how to generate these.
# Can also be left unset and configured instead from Settings > Frappe HRMS in the UI.
FRAPPE_BASE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Phase 3 — shared secret for /agent/cosec-agent's cloud endpoints. Generate
# with: openssl rand -hex 32. The agent's own .env must have the same value.
AGENT_SECRET=

# Secures the daily Frappe checkin-sync safety-net cron (/api/cron/frappe-sync,
# see vercel.json). Vercel sends this automatically as a Bearer token on
# cron-triggered requests once it's set as a project env var — generate with:
# openssl rand -hex 32. Not needed for local dev (crons only run in
# production deployments).
CRON_SECRET=
