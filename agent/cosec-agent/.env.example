# COSEC device API — this machine must be on the same LAN as the device.
COSEC_BASE_URL=http://192.168.0.107:85
COSEC_USERNAME=HR
COSEC_PASSWORD=

# Base URL up to and including /api/agent, e.g.:
#   local dev:  http://localhost:3000/api/agent
#   production: https://your-domain.vercel.app/api/agent
CLOUD_API_URL=

# Must match AGENT_SECRET in the cloud app's own .env — generate with: openssl rand -hex 32
AGENT_SECRET=

# How often to fetch today's attendance + events and push a heartbeat.
SYNC_INTERVAL_MINUTES=5
